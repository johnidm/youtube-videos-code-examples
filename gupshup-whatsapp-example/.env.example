# Gupshup API key — Dashboard > your app > Settings
GUPSHUP_API_KEY=your_api_key_here

# App name (the name you chose when creating the app, used as src.name)
GUPSHUP_APP_NAME=your_app_name

# App ID (UUID) — Dashboard > your app > Settings (not the same as the app name)
GUPSHUP_APP_ID=your_app_id_here

# Sandbox proxy number (default is Gupshup's sandbox number)
GUPSHUP_SOURCE_NUMBER=917834811114

# Gupshup API base URL (leave as default unless using a different region)
GUPSHUP_API_BASE_URL=https://api.gupshup.io
